# --- Required keys -----------------------------------------------------
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...

# --- LLM ----------------------------------------------------------------
OPENAI_MODEL=gpt-5.4-mini
REASONING_EFFORT=low
# Optional best-effort determinism: an integer passed as OpenAI's `seed`.
# Leave blank to disable. The active seed is recorded in every log row.
RUN_SEED=

# --- Embeddings (Pipeline A) ---------------------------------------------
# Selectable in the Configuration dropdown too. Options handled specially:
#   intfloat/multilingual-e5-base  = 768d, E5 "query:/passage:" prefixes (~1.1 GB)
#   BAAI/bge-m3                     = 1024d, no prefix; stronger cross-lingual
#                                    EN-query / DE-corpus (~2.3 GB, no custom code)
# Switching is non-destructive: each model builds its own index/namespace.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Pinecone -------------------------------------------------------------
PINECONE_INDEX=retrievallab
PINECONE_NAMESPACE=main
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Chunking (Pipeline A) -------------------------------------------------
# CHUNK_SIZE/CHUNK_OVERLAP apply INSIDE a clause that is longer than one chunk.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# 1 = cut chunks at clause headings (default); 0 = plain sliding window (ablation baseline)
CLAUSE_CHUNKING=1

# --- Tables: multi-vector handling ------------------------------------------
# 1 = index a vision-written summary of each detected table and keep the rendered
#     image for the answering call; 0 = raw page text only (ablation baseline).
# Detection runs at upload; summaries are made once at build time and cached.
TABLE_SUMMARIES=1
# 1 = attach the real table image to the final answering call (both pipelines)
ATTACH_TABLE_IMAGES=1
MAX_TABLE_IMAGES=3
# empty = use OPENAI_MODEL (already vision-capable)
VISION_MODEL=

# --- Defaults ---------------------------------------------------------------
DEFAULT_TOP_K=5
DEFAULT_MAX_STEPS=8
LOG_PATH=experiments.jsonl

# --- Persistence ------------------------------------------------------------
# Parsed pages + PageIndex trees + build state are written here so a restart
# doesn't require re-upload/rebuild. Set PERSIST=0 to keep everything in memory.
DATA_DIR=data
PERSIST=1

# --- Evaluation question set -------------------------------------------------
QUESTIONS_PATH=questions.json

# --- LLM judge (blind A vs B) ------------------------------------------------
# Cross-family judging mitigates self-preference bias (generator is GPT).
# For an Anthropic judge: JUDGE_PROVIDER=anthropic, set ANTHROPIC_API_KEY, and
# `pip install anthropic`. Otherwise an OpenAI JUDGE_MODEL is used.
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.4
# ANTHROPIC_API_KEY=sk-ant-...

# --- Cost model (USD per 1M tokens; 0 hides cost columns) --------------------
COST_PER_1M_IN=0
COST_PER_1M_OUT=0
