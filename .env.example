# --- Required keys -----------------------------------------------------
OPENAI_API_KEY=sk-...
PINECONE_API_KEY=pcsk_...
# Optional — uncomment only with a real value (a placeholder token is sent as-is).
# HF_TOKEN: not read by the app itself; load_dotenv() exports it and
# huggingface_hub uses it when sentence-transformers downloads the embedding model.
# HF_TOKEN=hf_...
# ANTHROPIC_API_KEY: used by app/judge_ref.py (reference-guided judge) and by the
# pairwise judge when JUDGE_PROVIDER=anthropic (JUDGE_MODEL must then be a Claude
# model id).
# ANTHROPIC_API_KEY=sk-ant-...

# --- LLM ----------------------------------------------------------------
OPENAI_MODEL=gpt-5.4-mini
REASONING_EFFORT=low

# --- Embeddings (Pipeline A) ---------------------------------------------
# E5 models get "query: " / "passage: " prefixes; other models (bge-m3) are
# encoded without a prefix. Switching is non-destructive: each model builds its
# own index/namespace. The namespaces below hold for the default chunking and
# table settings.
#
# ACTIVE: BAAI/bge-m3 = 1024d. This is the model the reported experiments ran
# under -> Pinecone index retrievallab-1024, namespace main-f015e15c.
EMBEDDING_MODEL=BAAI/bge-m3

# RESERVE: intfloat/multilingual-e5-base = 768d (~1.1 GB download), already
# built -> index retrievallab-768, namespace main-4446bd89. Ablation run:
# batch-e9f57386.
# EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Pinecone -------------------------------------------------------------
# PINECONE_INDEX and PINECONE_NAMESPACE are prefixes: the real index is
# <PINECONE_INDEX>-<dimension> (e.g. retrievallab-1024) and the real namespace is
# <PINECONE_NAMESPACE>-<hash of the index-time settings> (e.g. main-f015e15c).
PINECONE_INDEX=retrievallab
PINECONE_NAMESPACE=main
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Chunking (Pipeline A) -------------------------------------------------
# CHUNK_SIZE/CHUNK_OVERLAP split a clause that is longer than one chunk; for
# documents with fewer than 3 clause headings, and with CLAUSE_CHUNKING=0, they
# define a plain per-page character window.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Clause-aware cutting is ON by default. The character-window ablation was run
# with CLAUSE_CHUNKING=0 -> namespace main-35fa9be3, batch-c9000fd0 (still built).

# --- Defaults ---------------------------------------------------------------
DEFAULT_TOP_K=5
DEFAULT_MAX_STEPS=8
LOG_PATH=experiments.jsonl

# Every other setting is optional and falls back to its default in app/config.py:
# RUN_SEED, CLAUSE_CHUNKING, TABLE_SUMMARIES, ATTACH_TABLE_IMAGES, MAX_TABLE_IMAGES,
# VISION_MODEL, KEYWORD_STEM_DE, DATA_DIR, PERSIST, QUESTIONS_PATH, JUDGE_PROVIDER,
# JUDGE_MODEL, COST_PER_1M_IN, COST_PER_1M_OUT.
